# Copy to `.playlist.env` (in this directory) and fill in.
# The start.sh / stop.sh scripts load it via `--env-file .playlist.env`.

# Public domain for the site. Caddy obtains a TLS cert for it automatically.
# Point this domain's DNS A record at the VPS's public IP.
SITE_ADDRESS=playl.st

# Database name inside MongoDB.
DB_NAME=justdance

# Music-service client credentials — required only for `playlist-cli import`.
# You only need the credentials for the service(s) you import from; the service is
# chosen automatically from each playlist URL's host.

# Spotify — create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional, defaults to AU.
SPOTIFY_MARKET=AU

# Tidal — create an app at https://developer.tidal.com/dashboard
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
# Optional, defaults to AU.
TIDAL_COUNTRY=AU
