# Copy to `.playlist.env` (in this directory) and fill in.
# The start.sh / stop.sh scripts load it via `--env-file .playlist.env`.

# Public domain for the site. Caddy obtains a TLS cert for it automatically.
# Point this domain's DNS A record at the VPS's public IP.
SITE_ADDRESS=playl.st

# Database name inside MongoDB.
DB_NAME=justdance

# Spotify client credentials — required only for `playlist-cli import`.
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional, defaults to AU.
SPOTIFY_MARKET=AU
